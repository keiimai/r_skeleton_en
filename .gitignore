# --- Things Git does not track (README.md "Contents") ---

# --- Secrets (README.md "Contents") ---
.env.*
*.env
!.env.example
.Renviron
.httr-oauth
*.pem
*.key
secrets.yaml
secrets.yml
.Rhistory
.RDataTmp*
.Ruserdata

# --- Data (keep only .gitkeep and README.md) (README.md "Contents") ---
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# --- Outputs (keep only .gitkeep) (README.md "Contents") ---
models/**
!models/.gitkeep
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# --- Documents rendered in notebooks/, and working files and caches made while rendering (README.md "Contents") ---
notebooks/**/*.html
notebooks/**/*_files/
notebooks/**/*.pdf
notebooks/**/*.tex
notebooks/**/*.rmarkdown
notebooks/**/*.knit.md
notebooks/**/*_cache/
notebooks/**/.quarto
notebooks/**/.gitignore

# --- Word documents (README.md "Contents") ---
*.docx

# --- Raw data file extensions (README.md "Contents") ---
*.sav
*.zsav
*.por
*.rds
*.rda
*.RData
*.fst
*.qs2
*.dta
*.sas7bdat
*.xpt
*.parquet
*.feather
*.arrow
*.xlsx
*.xls
*.xlsm
*.dbf
*.accdb
*.mdb
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.csv
*.tsv

# --- Exception: tracked as evidence for reproducibility (README.md "Contents") ---
!docs/definition/*.csv

# --- Audio and video file extensions (README.md "Contents") ---
*.m4a
*.mp4
*.wav
*.mp3
*.flac
*.aac
*.ogg
*.mov
*.mkv
*.webm
*.aiff
*.aif

# --- Files created by R and RStudio (README.md "Contents") ---
.Rproj.user/
*.Rproj
Rplots.pdf

# --- Per-machine settings (README.md "Contents") ---
.claude/
.vscode/*

# --- Exception: VS Code settings distributed by the template (README.md "Contents") ---
!.vscode/settings.json

# --- Files created by the OS and editors (README.md "Contents") ---
.DS_Store
*.swp
