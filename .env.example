# --- Example file for environment variables (setup.R copies it to .env; skipped if .env exists) (REPRODUCIBILITY.md §2) ---

# --- Determinism of numerical computation (REPRODUCIBILITY.md §4) ---
# OMP_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1

# --- Time zone of the records (default Asia/Tokyo; do not change it partway; the recording layer uses this before the environment variable TZ) (REPRODUCIBILITY.md §2) ---
TZ=Asia/Tokyo

